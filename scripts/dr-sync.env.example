# Copy this file to /etc/htgcrm-dr-sync.env on the HQ3 CRM server.
# Keep the real file readable only by root because it contains secrets.

# HQ3 self-hosted Convex API URL.
HQ3_CONVEX_SELF_HOSTED_URL="https://crm-api.102-203-134-106.sslip.io"

# HQ3 self-hosted Convex admin key.
HQ3_CONVEX_SELF_HOSTED_ADMIN_KEY="replace-with-hq3-admin-key"

# HOA self-hosted Convex API URL. Prefer the private HOA IP from HQ3 if routing allows it.
HOA_CONVEX_SELF_HOSTED_URL="http://192.168.10.102:3210"

# HOA self-hosted Convex admin key.
HOA_CONVEX_SELF_HOSTED_ADMIN_KEY="replace-with-hoa-admin-key"

# Legacy Convex Cloud fallback only. Leave empty when HOA is self-hosted.
HOA_CONVEX_DEPLOY_KEY=""

# HQ3 CRM frontend health URL. If this is unhealthy, normal HQ3 -> HOA sync
# pauses to avoid overwriting HOA after failover users make changes there.
HQ3_CRM_HEALTH_URL="https://crm.102-203-134-106.sslip.io/"

# Local retention/logging on HQ3 CRM.
SNAPSHOT_DIR="/var/backups/htgcrm-dr-sync"
LOG_DIR="/var/log/htgcrm-dr-sync"
LOCK_FILE="/var/lock/htgcrm-dr-sync.lock"
KEEP_SNAPSHOTS="30"
